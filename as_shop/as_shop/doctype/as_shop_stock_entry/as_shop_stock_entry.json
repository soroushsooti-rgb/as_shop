{
  "doctype": "DocType",
  "name": "AS Shop Stock Entry",
  "module": "AS Shop",
  "custom": 0,
  "engine": "InnoDB",
  "field_order": [
    "product",
    "entry_type",
    "quantity",
    "notes",
    "result_section",
    "stock_change",
    "stock_before",
    "stock_after",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "product",
      "fieldtype": "Link",
      "label": "Product",
      "options": "AS Shop Product",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "entry_type",
      "fieldtype": "Select",
      "label": "Entry Type",
      "options": "Stock In\nStock Out\nAdjustment",
      "default": "Stock In",
      "reqd": 1,
      "in_list_view": 1,
      "description": "ورود، خروج یا اصلاح موجودی با مقدار مثبت یا منفی"
    },
    {
      "fieldname": "quantity",
      "fieldtype": "Int",
      "label": "Quantity",
      "reqd": 1,
      "in_list_view": 1,
      "description": "ورود/خروج: عدد مثبت؛ اصلاح: تغییر خالص مثبت یا منفی. برای موجودی اولیه ورود ثبت کنید."
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes",
      "description": "دلیل گردش، شماره رسید یا مرجع فروش"
    },
    {
      "fieldname": "result_section",
      "fieldtype": "Section Break",
      "label": "Calculated Stock Movement"
    },
    {
      "fieldname": "stock_change",
      "fieldtype": "Int",
      "label": "Stock Change",
      "read_only": 1
    },
    {
      "fieldname": "stock_before",
      "fieldtype": "Int",
      "label": "Stock Before",
      "read_only": 1
    },
    {
      "fieldname": "stock_after",
      "fieldtype": "Int",
      "label": "Stock After",
      "read_only": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "AS Shop Stock Entry",
      "read_only": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "AS Shop Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "format:AS-STK-{YYYY}-{#####}",
  "is_submittable": 1,
  "track_changes": 1
}
