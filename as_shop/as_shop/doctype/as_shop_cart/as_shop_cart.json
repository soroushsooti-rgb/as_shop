{
  "doctype": "DocType",
  "name": "AS Shop Cart",
  "module": "AS Shop",
  "autoname": "hash",
  "field_order": [
    "cart_token_hash",
    "token_last4",
    "status",
    "currency",
    "total_qty",
    "total_amount",
    "items"
  ],
  "fields": [
    {
      "fieldname": "cart_token_hash",
      "fieldtype": "Data",
      "label": "Cart Token Hash",
      "read_only": 1,
      "unique": 1,
      "hidden": 1
    },
    {
      "fieldname": "token_last4",
      "fieldtype": "Data",
      "label": "Token Last 4",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Open\nSubmitted\nAbandoned",
      "default": "Open",
      "in_list_view": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Data",
      "label": "Currency",
      "default": "Toman",
      "read_only": 1
    },
    {
      "fieldname": "total_qty",
      "fieldtype": "Int",
      "label": "Total Quantity",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "total_amount",
      "fieldtype": "Currency",
      "label": "Total Amount (Toman)",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "AS Shop Cart Item"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "AS Shop Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    }
  ],
  "track_changes": 1
}
