{
  "doctype": "DocType",
  "name": "AS Shop Product",
  "module": "AS Shop",
  "custom": 0,
  "engine": "InnoDB",
  "field_order": [
    "identity_section",
    "product_code",
    "title",
    "title_en",
    "category",
    "caption",
    "caption_en",
    "description",
    "description_en",
    "pricing_section",
    "price",
    "price_2",
    "price_3",
    "price_4_plus",
    "show_on_website",
    "manual_out_of_stock",
    "stock_qty",
    "sort_order",
    "gallery_section",
    "cover_image",
    "images"
  ],
  "fields": [
    {
      "fieldname": "identity_section",
      "fieldtype": "Section Break",
      "label": "Product Information"
    },
    {
      "fieldname": "product_code",
      "fieldtype": "Data",
      "label": "Product Code",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "شناسه ثابت انگلیسی مانند french-bulldog؛ بعد از ساخت تغییر نمی‌کند."
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1,
      "description": "عنوان فارسی یا عنوان اصلی محصول"
    },
    {
      "fieldname": "title_en",
      "fieldtype": "Data",
      "label": "English Title"
    },
    {
      "fieldname": "category",
      "fieldtype": "Select",
      "label": "Category",
      "options": "pets\nfamily\nkitchen\nnfc\ngadgets\nhome\nfurniture\nother",
      "default": "pets",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "caption",
      "fieldtype": "Small Text",
      "label": "Caption",
      "description": "متن کوتاه زیر عنوان کارت محصول"
    },
    {
      "fieldname": "caption_en",
      "fieldtype": "Small Text",
      "label": "English Caption"
    },
    {
      "fieldname": "description",
      "fieldtype": "Long Text",
      "label": "Description",
      "description": "توضیحات کامل محصول؛ متن ساده"
    },
    {
      "fieldname": "description_en",
      "fieldtype": "Long Text",
      "label": "English Description"
    },
    {
      "fieldname": "pricing_section",
      "fieldtype": "Section Break",
      "label": "Price and Publication"
    },
    {
      "fieldname": "price",
      "fieldtype": "Currency",
      "label": "Price (Toman)",
      "reqd": 1,
      "precision": "0",
      "in_list_view": 1,
      "description": "قیمت هر واحد وقتی مجموع تعداد سبد یک عدد است، به تومان."
    },
    {
      "fieldname": "price_2",
      "fieldtype": "Currency",
      "label": "Unit Price at Basket Quantity 2 (Toman)",
      "precision": "0",
      "description": "قیمت هر واحد از این محصول بر اساس مجموع تعداد تمام محصولات داخل سبد؛ صفر یا خالی یعنی قیمت اصلی."
    },
    {
      "fieldname": "price_3",
      "fieldtype": "Currency",
      "label": "Unit Price at Basket Quantity 3 (Toman)",
      "precision": "0",
      "description": "قیمت هر واحد از این محصول بر اساس مجموع تعداد تمام محصولات داخل سبد؛ صفر یا خالی یعنی قیمت اصلی."
    },
    {
      "fieldname": "price_4_plus",
      "fieldtype": "Currency",
      "label": "Unit Price at Basket Quantity 4+ (Toman)",
      "precision": "0",
      "description": "قیمت هر واحد از این محصول بر اساس مجموع تعداد تمام محصولات داخل سبد؛ صفر یا خالی یعنی قیمت اصلی."
    },
    {
      "fieldname": "show_on_website",
      "fieldtype": "Check",
      "label": "Show on Website",
      "default": "0",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "با برداشتن تیک، محصول از فهرست و صفحه عمومی حذف می‌شود؛ سند مدیریتی باقی می‌ماند."
    },
    {
      "fieldname": "manual_out_of_stock",
      "fieldtype": "Check",
      "label": "Mark as Out of Stock",
      "default": "0",
      "in_list_view": 1,
      "description": "حتی با موجودی مثبت، فروش محصول را در سایت غیرفعال می‌کند."
    },
    {
      "fieldname": "stock_qty",
      "fieldtype": "Int",
      "label": "Stock Quantity",
      "read_only": 1,
      "default": "0",
      "in_list_view": 1,
      "description": "خودکار از اسناد ثبت‌شده گردش موجودی؛ برای تغییر، Stock Entry بسازید."
    },
    {
      "fieldname": "sort_order",
      "fieldtype": "Int",
      "label": "Display Order",
      "default": "0"
    },
    {
      "fieldname": "gallery_section",
      "fieldtype": "Section Break",
      "label": "Images and Gallery"
    },
    {
      "fieldname": "cover_image",
      "fieldtype": "Attach Image",
      "label": "Cover Image",
      "description": "تصویر اصلی کارت محصول؛ فایل عمومی بارگذاری کنید."
    },
    {
      "fieldname": "images",
      "fieldtype": "Table",
      "label": "Gallery",
      "options": "AS Shop Product Image"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "AS Shop Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "field:product_code",
  "title_field": "title",
  "search_fields": "title,title_en,product_code",
  "image_field": "cover_image",
  "track_changes": 1,
  "allow_rename": 0
}
